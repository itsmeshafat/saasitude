<?php $__env->startSection('title', 'Pricing — plans for every stage'); ?>
<?php $__env->startSection('meta_description', 'Transparent SaaS pricing in USD and BDT. Monthly or annual billing, 14-day free trial, cancel anytime.'); ?>

<?php $__env->startSection('content'); ?>


<section class="pricing">
    <h1>Simple, transparent pricing</h1>
    <p>USD via Stripe/Paddle · ৳BDT via SSLCommerz · 14-day free trial</p>

    <div class="controls">
        <div class="pill" role="group" aria-label="Billing interval">
            <button type="button" class="on" data-toggle="interval" data-value="month">Monthly</button>
            <button type="button" data-toggle="interval" data-value="year">Annual −17%</button>
        </div>
        <div class="pill" role="group" aria-label="Currency">
            <button type="button" class="on" data-toggle="currency" data-value="USD">$ USD</button>
            <button type="button" data-toggle="currency" data-value="BDT">৳ BDT</button>
        </div>
    </div>

    <div class="plans" id="plan-grid" data-interval="month" data-currency="USD">
        <?php $__currentLoopData = $plans; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $plan): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
            <div class="plan glass <?php echo e($plan->slug === 'starter' ? 'featured' : ''); ?>">
                <?php if($plan->slug === 'starter'): ?><span class="pop">Most popular</span><?php endif; ?>
                <h2><?php echo e($plan->name); ?></h2>
                <?php $__currentLoopData = ['month', 'year']; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $interval): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                    <?php $__currentLoopData = ['USD', 'BDT']; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $currency): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                        <?php ($price = $plan->prices->first(fn ($p) => $p->currency === $currency && $p->interval === $interval)); ?>
                        <?php if($price): ?>
                            <div class="price" data-price
                                 data-interval="<?php echo e($interval); ?>" data-currency="<?php echo e($currency); ?>"
                                 <?php echo e($interval !== 'month' || $currency !== 'USD' ? 'hidden' : ''); ?>>
                                <?php echo e($currency === 'USD' ? '$' : '৳'); ?><?php echo e(number_format($price->amount_minor / 100, 0)); ?><small>/<?php echo e($interval === 'year' ? 'yr' : 'mo'); ?></small>
                            </div>
                        <?php endif; ?>
                    <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
                <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
                <div class="missing" data-missing hidden>Not available in this billing option</div>
                <p style="font-size:14px;color:var(--muted-foreground);margin-top:8px"><?php echo e($plan->description); ?></p>
                <ul>
                    <?php $__currentLoopData = $plan->planFeatures->filter(fn($pf) => $pf->feature); $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $pf): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                        <li><?php echo e($pf->feature->name); ?><?php if($pf->feature->type !== 'boolean'): ?> —
                            <?php if($pf->value === '-1'): ?> unlimited <?php else: ?> <?php echo e($pf->value); ?> <?php endif; ?>
                        <?php endif; ?></li>
                    <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
                </ul>
                <a class="btn <?php echo e($plan->slug === 'starter' ? 'btn-primary' : 'btn-outline'); ?>" href="<?php echo e(url('/register')); ?>">
                    <?php echo e($plan->slug === 'free' ? 'Get started' : 'Start free trial'); ?>

                </a>
            </div>
        <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
    </div>
</section>

<script>
(function () {
    var grid = document.getElementById('plan-grid');
    if (!grid) return;

    function sync() {
        var interval = grid.dataset.interval;
        var currency = grid.dataset.currency;

        document.querySelectorAll('[data-price]').forEach(function (el) {
            var match = el.dataset.interval === interval && el.dataset.currency === currency;
            el.hidden = !match;
        });

        document.querySelectorAll('[data-missing]').forEach(function (el) {
            var anyVisible = document.querySelector(
                '[data-price][data-interval="' + interval + '"][data-currency="' + currency + '"]'
            );
            el.hidden = !!anyVisible;
        });
    }

    document.querySelectorAll('[data-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var group = btn.dataset.toggle;
            document.querySelectorAll('[data-toggle="' + group + '"]').forEach(function (b) {
                b.classList.toggle('on', b === btn);
            });
            grid.dataset[group] = btn.dataset.value;
            sync();
        });
    });

    sync();
})();
</script>
<?php $__env->stopSection(); ?>
<?php echo $__env->make('layouts.public', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?><?php /**PATH C:\laragon\www\saas\resources\views/public/pricing.blade.php ENDPATH**/ ?>