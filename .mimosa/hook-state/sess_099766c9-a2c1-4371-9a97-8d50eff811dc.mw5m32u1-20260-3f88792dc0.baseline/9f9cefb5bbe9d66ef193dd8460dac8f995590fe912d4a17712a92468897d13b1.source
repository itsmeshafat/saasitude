        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table { border-collapse: collapse !important; }
        img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        @media screen and (max-width: 525px) {
            .mobile-padding { padding: 28px 24px !important; }
            .mobile-title { font-size: 22px !important; }
            .mobile-button { padding: 14px 28px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: <?php echo e($brand['page_bg']); ?>; font-family: 'Aeonik', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: <?php echo e($brand['page_bg']); ?>;">
<tr>
    <td align="center" style="padding: 48px 16px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; background-color: <?php echo e($brand['card_bg']); ?>; border-radius: 12px; border: 1px solid <?php echo e($brand['border']); ?>; overflow: hidden;">
            
            <tr>
                <td style="padding: 20px 40px; background-color: <?php echo e($brand['accent_tint']); ?>; border-bottom: 1px solid <?php echo e($brand['border']); ?>;" align="left">
                    <?php if($brand['logo']): ?>
                        <img src="<?php echo e($brand['logo']); ?>" alt="<?php echo e($brand['app_name']); ?>" height="28" style="display: block; height: 28px; width: auto;">
                    <?php else: ?>
                        <span style="font-size: 15px; font-weight: 800; color: <?php echo e($brand['text']); ?>; letter-spacing: -0.01em;">
                            <?php echo e($brand['app_name']); ?><span style="color: <?php echo e($brand['primary']); ?>;">.</span>
                        </span>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td class="mobile-padding" style="padding: 40px 40px 32px 40px;" align="left">
                    <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: <?php echo e($brand['primary']); ?>; padding-bottom: 12px;">
                        <?php echo e($brand['app_name']); ?>

                    </div>
                    <h1 class="mobile-title" style="margin: 0 0 20px 0; font-size: 26px; line-height: 32px; color: <?php echo e($brand['text']); ?>; font-weight: 700;">
                        <?php echo e($title); ?>

                    </h1>

                    <?php $__currentLoopData = ($lines ?? []); $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $line): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                        <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: <?php echo e($brand['muted_text']); ?>;"><?php echo $line; ?></p>
                    <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>

                    <?php if(!empty($actionUrl)): ?>
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0;">
                            <tr>
                                <td align="center" bgcolor="<?php echo e($brand['primary']); ?>" style="border-radius: 8px;">
                                    <a href="<?php echo e($actionUrl); ?>" class="mobile-button" style="display: inline-block; padding: 12px 24px; font-size: 15px; font-weight: 600; color: <?php echo e($brand['primary_foreground']); ?>; text-decoration: none; border-radius: 8px;">
                                        <?php echo e($actionLabel ?? 'View details'); ?>

                                    </a>
                                </td>
                            </tr>
                        </table>
                    <?php endif; ?>

                    <?php echo $__env->yieldContent('footer'); ?>
                </td>
            </tr>
        </table>
        <p style="margin: 24px 0 0 0; font-size: 12px; line-height: 18px; color: <?php echo e($brand['footer_text']); ?>; text-align: center;">
            © <?php echo e(now()->year); ?> <?php echo e($brand['app_name']); ?> · <a href="<?php echo e(url('/')); ?>" style="color: <?php echo e($brand['footer_text']); ?>;"><?php echo e(url('/')); ?></a>
            <?php if($brand['support_email']): ?>
                · <a href="mailto:<?php echo e($brand['support_email']); ?>" style="color: <?php echo e($brand['footer_text']); ?>;">Support</a>
