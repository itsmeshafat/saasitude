<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames(([
    'values' => [],
    'labels' => [],
    'height' => 150,
    'color' => 'var(--primary)',
]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter(([
    'values' => [],
    'labels' => [],
    'height' => 150,
    'color' => 'var(--primary)',
]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $heights = \App\Support\SvgChart::barHeights(array_values($values));
    // Tyro pattern: value caption + bar + label live in the SAME grid cell — cannot misalign.
?>

<div class="chart-bars" <?php echo e($attributes); ?>>
    <?php if($values !== []): ?>
        <div class="rounded-[10px] border p-4" style="border-color: var(--border); background: var(--muted);">
            <div class="grid items-end gap-1.5" style="grid-template-columns: repeat(<?php echo e(count($values)); ?>, 1fr); height: <?php echo e($height); ?>px;">
                <?php $__currentLoopData = $heights; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $i => $pct): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                    <div class="flex flex-col items-center justify-end h-full gap-1" title="<?php echo e(($labels[$i] ?? '').': '.number_format($values[$i])); ?>">
                        <span class="text-[10px] leading-none text-[var(--muted-foreground)]"><?php echo e(\App\Support\SvgChart::compact($values[$i])); ?></span>
                        <div class="w-full rounded-t-md" style="height: <?php echo e($pct); ?>%; background: <?php echo e($color); ?>; opacity: <?php echo e(0.45 + 0.55 * ($pct / 100)); ?>;"></div>
                    </div>
                <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
            </div>
        </div>
        <?php if($labels): ?>
            <div class="grid gap-1.5 text-xs text-[var(--muted-foreground)] mt-2" style="grid-template-columns: repeat(<?php echo e(count($labels)); ?>, 1fr);">
                <?php $__currentLoopData = $labels; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $label): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                    <span class="text-center truncate"><?php echo e($label); ?></span>
                <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="rounded-[10px] border p-4 text-sm text-[var(--muted-foreground)] text-center"
             style="border-color: var(--border); background: var(--muted);">No data yet</div>
    <?php endif; ?>
</div>
