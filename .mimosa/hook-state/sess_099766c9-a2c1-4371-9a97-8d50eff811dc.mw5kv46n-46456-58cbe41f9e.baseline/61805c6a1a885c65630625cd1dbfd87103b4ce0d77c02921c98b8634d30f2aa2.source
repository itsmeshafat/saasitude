<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames(([
    'values' => [],
    'labels' => [],
    'height' => 200,
    'width' => 600,
    'area' => true,
    'color' => 'var(--primary)',
]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter(([
    'values' => [],
    'labels' => [],
    'height' => 200,
    'width' => 600,
    'area' => true,
    'color' => 'var(--primary)',
]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $line = \App\Support\SvgChart::linePath($values, $width, $height);
    $fill = $area ? \App\Support\SvgChart::areaPath($values, $width, $height) : null;
    $uid = 'chart-gradient-'.md5($line.json_encode($values));
    // Tyro pattern: first/last range labels only (per-point labels can't align with inset points).
    $firstLabel = $labels[0] ?? null;
    $lastLabel = count($labels) > 1 ? $labels[count($labels) - 1] : null;
?>

<div class="chart-line" <?php echo e($attributes); ?>>
    <?php if($line !== ''): ?>
        <div class="rounded-[10px] border p-4" style="border-color: var(--border); background: var(--muted);">
            <svg viewBox="0 0 <?php echo e($width); ?> <?php echo e($height); ?>" width="100%" height="<?php echo e($height); ?>"
                 style="display: block;" preserveAspectRatio="none"
                 role="img" aria-label="<?php echo e($labels ? implode(' → ', [$firstLabel, $lastLabel]) : 'Line chart'); ?>">
                <defs>
                    <linearGradient id="<?php echo e($uid); ?>" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="<?php echo e($color); ?>" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="<?php echo e($color); ?>" stop-opacity="0.02" />
                    </linearGradient>
                </defs>
                <?php if($fill): ?>
                    <path d="<?php echo e($fill); ?>" fill="url(#<?php echo e($uid); ?>)" />
                <?php endif; ?>
                <path d="<?php echo e($line); ?>" fill="none" stroke="<?php echo e($color); ?>" stroke-width="2.5" stroke-linecap="round" />
            </svg>
        </div>
        <?php if($firstLabel || $lastLabel): ?>
            <div class="flex justify-between text-xs text-[var(--muted-foreground)] mt-2">
                <span><?php echo e($firstLabel); ?></span>
                <span><?php echo e($lastLabel); ?></span>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="rounded-[10px] border p-4 text-sm text-[var(--muted-foreground)] text-center"
             style="border-color: var(--border); background: var(--muted);">No data yet</div>
    <?php endif; ?>
</div>
<?php /**PATH C:\laragon\www\saas\resources\views/components/chart/line.blade.php ENDPATH**/ ?>