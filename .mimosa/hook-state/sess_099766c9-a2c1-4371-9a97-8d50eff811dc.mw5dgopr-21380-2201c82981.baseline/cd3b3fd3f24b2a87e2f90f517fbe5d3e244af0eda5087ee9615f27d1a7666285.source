<?php $__env->startSection('title', $config['title'] . ' Details'); ?>

<?php $__env->startSection('breadcrumb'); ?>
<a href="<?php echo e(route($dashboardRoute::name('index'))); ?>">Dashboard</a>
<span class="breadcrumb-separator">/</span>
<a href="<?php echo e(route($dashboardRoute::name('resources.index'), $resource)); ?>"><?php echo e($config['title']); ?></a>
<span class="breadcrumb-separator">/</span>
<span>Details</span>
<?php $__env->stopSection(); ?>

<?php $__env->startSection('content'); ?>
<div class="page-header">
    <div class="page-header-row">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="<?php echo e(route($dashboardRoute::name('resources.index'), $resource)); ?>" class="btn btn-ghost" title="Back to <?php echo e($config['title']); ?>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>
            <h1 class="page-title"><?php echo e(Str::singular($config['title'])); ?> Details</h1>
        </div>
        <div>
            <?php if(!($isReadonly ?? false)): ?>
            <a href="<?php echo e(route($dashboardRoute::name('resources.edit'), [$resource, $item->id])); ?>" class="btn btn-primary">Edit</a>
            <form action="<?php echo e(route($dashboardRoute::name('resources.destroy'), [$resource, $item->id])); ?>" method="POST" style="display: inline;" id="delete-resource-form">
                <?php echo csrf_field(); ?>
                <?php echo method_field('DELETE'); ?>
                <button type="button" class="btn btn-danger" onclick="event.preventDefault(); showDanger('Delete Item', 'Are you sure you want to delete this item?').then(confirmed => { if(confirmed) document.getElementById('delete-resource-form').submit(); })">Delete</button>
            </form>
            <?php endif; ?>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="details-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
            <?php $__currentLoopData = $config['fields']; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $key => $field): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                <?php if(!($field['hide_in_single_view'] ?? false)): ?>
                <div class="detail-item">
                    <div class="detail-label" style="font-weight: 500; color: var(--text-secondary); margin-bottom: 0.25rem;"><?php echo e($field['label']); ?></div>
                    <div class="detail-value" style="font-size: 1rem; color: var(--text-primary);">
                        <?php if($field['type'] === 'file'): ?>
                            <?php if($item->$key): ?>
                                <a href="<?php echo e(Storage::url($item->$key)); ?>" target="_blank" style="color: var(--primary); text-decoration: none;">View File</a>
                            <?php else: ?>
                                -
                            <?php endif; ?>
                        <?php elseif($field['type'] === 'multiselect' || ($field['type'] === 'checkbox' && isset($field['relationship'])) || ($field['type'] === 'select' && ($field['multiple'] ?? false))): ?>
                             <?php if(isset($field['relationship'])): ?>
                                 <?php echo e($item->{$field['relationship']}->pluck($field['option_label'] ?? 'name')->implode(', ') ?: '-'); ?>

                             <?php else: ?>
                                 <?php echo e(is_array($item->$key) ? implode(', ', $item->$key) : $item->$key); ?>

                             <?php endif; ?>
                        <?php elseif(($field['type'] === 'select' || $field['type'] === 'radio') && isset($field['options'])): ?>
                            <?php echo e($field['options'][$item->$key] ?? $item->$key); ?>

                        <?php elseif(isset($field['relationship'])): ?>
                            <?php echo e(optional($item->{$field['relationship']})->{$field['option_label'] ?? 'name'} ?? '-'); ?>

                        <?php elseif($field['type'] === 'boolean'): ?>
                            <span class="badge <?php echo e($item->$key ? 'badge-success' : 'badge-secondary'); ?>">
                                <?php echo e($item->$key ? 'Yes' : 'No'); ?>

                            </span>
                        <?php elseif($field['type'] === 'textarea'): ?>
                            <div style="white-space: pre-wrap;"><?php echo e($item->$key); ?></div>
                        <?php elseif($field['type'] === 'richtext'): ?>
                            <div class="richtext-content"><?php echo $sanitizedRichtext[$key] ?? e($item->$key); ?></div>
                        
                        <?php elseif($field['type'] === 'markdown'): ?>
                            <div class="markdown-content" id="markdown-<?php echo e($key); ?>"></div>
                            <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
                            <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
                            <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    var content = <?php echo json_encode($item->$key ?? '', 15, 512) ?>;
                                    document.getElementById('markdown-<?php echo e($key); ?>').innerHTML = DOMPurify.sanitize(marked.parse(content));
                                });
                            </script>
                        <?php else: ?>
                            <?php echo e($item->$key); ?>

                        <?php endif; ?>
                    </div>
                </div>
                <?php endif; ?>
            <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
        </div>
    </div>
</div>
<?php $__env->stopSection(); ?>

<?php echo $__env->make('tyro-dashboard::layouts.app', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?><?php /**PATH C:\laragon\www\saas\vendor\hasinhayder\tyro-dashboard\resources\views\resources\show.blade.php ENDPATH**/ ?>