    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $titleValue = $title instanceof \Illuminate\View\ComponentSlot ? trim((string) $title) : (string) ($title ?? '');
    $descValue = $description instanceof \Illuminate\View\ComponentSlot ? trim((string) $description) : (string) ($description ?? '');
    $hasActions = isset($actions) && trim((string) $actions) !== '';
?>

<div <?php echo e($attributes->merge(['class' => 'page-header'])); ?>>
    <div class="page-header-row">
        <div style="min-width:0;">
            <?php if($titleValue !== ''): ?>
                <h1 class="page-title"><?php echo e($titleValue); ?></h1>
            <?php endif; ?>
            <?php if($descValue !== ''): ?>
                <p class="page-description"><?php echo $descValue; ?></p>
            <?php endif; ?>
        </div>
        <?php if($hasActions): ?>
            <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;"><?php echo $actions; ?></div>
        <?php endif; ?>
    </div>
</div>
