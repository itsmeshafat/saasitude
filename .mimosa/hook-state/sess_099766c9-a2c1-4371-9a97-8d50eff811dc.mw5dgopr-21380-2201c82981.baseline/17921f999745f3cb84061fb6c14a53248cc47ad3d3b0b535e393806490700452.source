    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $variant = in_array((string) $variant, ['primary','success','warning','error','info'], true) ? (string) $variant : 'primary';
    $value = max(0, min(100, (int) $value));
    $showLabel = filter_var($showLabel, FILTER_VALIDATE_BOOL);
    $hasLabel = filled($label);
    $trackHeight = ctype_digit((string) $height) ? $height.'px' : $height;
?>

<div <?php echo e($attributes->merge(['class' => 'progress-wrapper'])); ?>>
    <?php if($hasLabel || $showLabel): ?>
        <div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; margin-bottom:0.375rem;">
            <?php if($hasLabel): ?>
                <span style="font-size:0.8125rem; font-weight:500; color: var(--muted-foreground); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><?php echo e($label); ?></span>
            <?php endif; ?>
            <?php if($showLabel): ?>
                <span style="font-size:0.8125rem; font-weight:500; color: var(--muted-foreground); flex-shrink:0;"><?php echo e($value); ?>%</span>
            <?php endif; ?>
        </div>
    <?php endif; ?>
    <div class="progress-track" role="progressbar" aria-valuenow="<?php echo e($value); ?>" aria-valuemin="0" aria-valuemax="100"<?php if($hasLabel): ?> aria-label="<?php echo e($label); ?>"<?php endif; ?> style="height: <?php echo e($trackHeight); ?>;">
        <div class="progress-bar progress-bar-<?php echo e($variant); ?>" style="width: <?php echo e($value); ?>%; height: 100%;"></div>
    </div>
</div>
