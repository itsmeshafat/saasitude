<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames(([
    'name' => null,
    'id' => null,
    'value' => null,
    'label' => null,
    'placeholder' => null,
    'help' => null,
    'showError' => true,
    'height' => '300px',
    'toolbar' => 'bold,italic,heading,|,quote,unordered-list,ordered-list,|,link,image,|,preview',
    'spellChecker' => false,
    'status' => false,
    'output' => 'select',
    'fullUrl' => true,
    'columns' => null,
    'options' => [],
]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter(([
    'name' => null,
    'id' => null,
    'value' => null,
    'label' => null,
    'placeholder' => null,
    'help' => null,
    'showError' => true,
    'height' => '300px',
    'toolbar' => 'bold,italic,heading,|,quote,unordered-list,ordered-list,|,link,image,|,preview',
    'spellChecker' => false,
    'status' => false,
    'output' => 'select',
    'fullUrl' => true,
    'columns' => null,
    'options' => [],
]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $fieldId = $id ?: ($name ? 'tyro-dashboard-editor-'.str_replace(['.', '[', ']'], '-', $name) : 'tyro-dashboard-editor-'.uniqid('', true));
    $fieldValue = $name ? old($name, $value) : $value;

    // Picker output mode: select|webp|original|thumb (invalid -> select).
    $outputMode = in_array((string) $output, ['select', 'webp', 'original', 'thumb'], true) ? (string) $output : 'select';

    // fullUrl defaults to TRUE here (opposite of <x-media-picker>): Markdown and
    // email rendering need absolute URLs, so the picker is asked for the full URL.
    $useFullUrl = filter_var($fullUrl, FILTER_VALIDATE_BOOL);

    // Normalize the toolbar prop (comma string or array) to a JSON-ready array.
    if (is_string($toolbar)) {
        $toolbarItems = array_values(array_filter(array_map('trim', explode(',', $toolbar)), fn ($item) => $item !== ''));
    } else {
        $toolbarItems = is_array($toolbar) ? array_values($toolbar) : [];
    }

    $jsonFlags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;

    $pickerColumns = (is_numeric($columns) && (int) $columns > 0) ? (int) $columns : null;
    $spellCheckerValue = filter_var($spellChecker, FILTER_VALIDATE_BOOL);
    $renderError = filter_var($showError, FILTER_VALIDATE_BOOL);
?>

<div class="tyro-editor-field" data-tyro-editor-field>
    <?php if($label): ?>
        <label class="form-label" for="<?php echo e($fieldId); ?>"><?php echo e($label); ?></label>
    <?php endif; ?>

    <textarea
        <?php echo e($attributes->merge(['class' => 'form-input'])); ?>

        <?php if($name): ?> name="<?php echo e($name); ?>" <?php endif; ?>
        id="<?php echo e($fieldId); ?>"
        placeholder="<?php echo e($placeholder); ?>"
        data-tyro-editor
        data-height="<?php echo e($height); ?>"
        data-output="<?php echo e($outputMode); ?>"
        data-full-url="<?php echo e($useFullUrl ? 'true' : 'false'); ?>"
        data-toolbar="<?php echo e(json_encode($toolbarItems, $jsonFlags)); ?>"
        data-options="<?php echo e(json_encode($options, $jsonFlags)); ?>"
        data-spellchecker="<?php echo e($spellCheckerValue ? 'true' : 'false'); ?>"
        data-status="<?php echo e(json_encode($status, $jsonFlags)); ?>"
        <?php if($pickerColumns): ?> data-columns="<?php echo e($pickerColumns); ?>" <?php endif; ?>
    ><?php echo e($fieldValue); ?></textarea>

    <?php if($help): ?>
        <div class="form-help-text" style="color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.25rem;"><?php echo e($help); ?></div>
    <?php endif; ?>

    <?php if($name && $renderError): ?>
        <?php $__errorArgs = [$name];
$__bag = $errors->getBag($__errorArgs[1] ?? 'default');
if ($__bag->has($__errorArgs[0])) :
if (isset($message)) { $__messageOriginal = $message; }
$message = $__bag->first($__errorArgs[0]); ?>
        <div class="form-error" style="color: var(--danger); font-size: 0.875rem; margin-top: 0.25rem;"><?php echo e($message); ?></div>
        <?php unset($message);
if (isset($__messageOriginal)) { $message = $__messageOriginal; }
endif;
unset($__errorArgs, $__bag); ?>
    <?php endif; ?>
</div>

<?php if (! $__env->hasRenderedOnce('tyro-media-assets')): $__env->markAsRenderedOnce('tyro-media-assets'); ?>
    <?php $__env->startPush('styles'); ?>
        <?php echo $__env->make('tyro-dashboard::partials.media-styles', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?>
    <?php $__env->stopPush(); ?>

    <?php $__env->startPush('scripts'); ?>
        <?php echo $__env->make('tyro-dashboard::partials.media-script', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?>
    <?php $__env->stopPush(); ?>
<?php endif; ?>

<?php if (! $__env->hasRenderedOnce('tyro-editor-assets')): $__env->markAsRenderedOnce('tyro-editor-assets'); ?>
    <?php $__env->startPush('styles'); ?>
        <link rel="stylesheet" href="<?php echo e(config('tyro-dashboard.editor.css_url', 'https://cdn.jsdelivr.net/npm/easymde@2.20.0/dist/easymde.min.css')); ?>">
        <?php echo $__env->make('tyro-dashboard::partials.editor-styles', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?>
    <?php $__env->stopPush(); ?>

    <?php $__env->startPush('scripts'); ?>
        <script src="<?php echo e(config('tyro-dashboard.editor.js_url', 'https://cdn.jsdelivr.net/npm/easymde@2.20.0/dist/easymde.min.js')); ?>"></script>
        <?php echo $__env->make('tyro-dashboard::partials.editor-script', array_diff_key(get_defined_vars(), ['__data' => 1, '__path' => 1]))->render(); ?>
    <?php $__env->stopPush(); ?>
<?php endif; ?>
