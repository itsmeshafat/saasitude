<tr>
    <td align="center" style="padding: 48px 16px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e5e7eb;">
            <tr>
                <td class="mobile-padding" style="padding: 40px 40px 32px 40px;" align="left">
                    <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #2563eb; padding-bottom: 12px;">
                        <?php echo e(config('app.name')); ?>

                    </div>
                    <h1 class="mobile-title" style="margin: 0 0 20px 0; font-size: 26px; line-height: 32px; color: #111827; font-weight: 700;">
                        <?php echo e($title); ?>

                    </h1>

                    <?php $__currentLoopData = ($lines ?? []); $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $line): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
