<?php $attributes ??= new \Illuminate\View\ComponentAttributeBag;

$__newAttributes = [];
$__propNames = \Illuminate\View\ComponentAttributeBag::extractPropNames((['plan', 'price', 'featured' => false, 'current' => false]));

foreach ($attributes->all() as $__key => $__value) {
    if (in_array($__key, $__propNames)) {
        $$__key = $$__key ?? $__value;
    } else {
        $__newAttributes[$__key] = $__value;
    }
}

$attributes = new \Illuminate\View\ComponentAttributeBag($__newAttributes);

unset($__propNames);
unset($__newAttributes);

foreach (array_filter((['plan', 'price', 'featured' => false, 'current' => false]), 'is_string', ARRAY_FILTER_USE_KEY) as $__key => $__value) {
    $$__key = $$__key ?? $__value;
}

$__defined_vars = get_defined_vars();

foreach ($attributes->all() as $__key => $__value) {
    if (array_key_exists($__key, $__defined_vars)) unset($$__key);
}

unset($__defined_vars, $__key, $__value); ?>

<?php
    $cardCls = $featured
        ? 'border-2 border-[var(--primary)] bg-[var(--primary)] text-[var(--primary-foreground)] shadow-lg'
        : 'border border-[var(--border)] bg-[var(--card)] text-[var(--card-foreground)] shadow-[var(--card-shadow,0_1px_2px_0_rgb(0_0_0/0.05))]';
    $mutedCls = $featured
        ? 'text-[var(--primary-foreground)]/70'
        : 'text-[var(--muted-foreground)]';
?>

<div <?php echo e($attributes->merge(['class' => 'relative flex flex-col gap-5 rounded-[calc(var(--radius)+2px)] p-6 ' . $cardCls])); ?>>
    <?php if($featured): ?>
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-white px-3 py-0.5 text-xs font-semibold text-[var(--primary)] shadow">
            Most Popular
        </span>
    <?php endif; ?>

    <div>
        <p class="text-xs font-semibold uppercase tracking-widest <?php echo e($mutedCls); ?>"><?php echo e($plan->name); ?></p>
        <p class="mt-2 flex items-baseline gap-1">
            <span class="text-4xl font-bold plan-card-price"><?php echo e($price); ?></span>
            <span class="text-sm <?php echo e($mutedCls); ?>">/mo</span>
        </p>
    </div>

    <div class="flex-1 text-sm <?php echo e($mutedCls); ?>">
        <?php echo e($slot); ?>

    </div>

    <?php if($current): ?>
        <span class="text-center text-sm font-medium <?php echo e($mutedCls); ?>">Current plan</span>
    <?php endif; ?>
</div>
