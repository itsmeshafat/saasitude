<?php if(auth()->guard()->check()): ?>
    <?php
        $current = auth()->user()->currentWorkspace();
        $all = auth()->user()->workspaces;
    ?>

    <?php if($current): ?>
        <div x-data="{ open: false }" class="relative">
            <button @click="open = !open" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md hover:bg-gray-100">
                <span><?php echo e($current->name); ?></span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>

            <div x-show="open" @click.outside="open = false"
                 class="absolute left-0 mt-1 w-56 bg-white border rounded-md shadow-lg z-50">
                <?php $__currentLoopData = $all; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $workspace): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                    <form method="POST" action="<?php echo e(route('dashboard.workspace.switch')); ?>">
                        <?php echo csrf_field(); ?>
                        <input type="hidden" name="workspace_id" value="<?php echo e($workspace->id); ?>">
                        <button type="submit"
                                class="w-full text-left px-4 py-2 text-sm hover:bg-gray-50 <?php echo e($workspace->id === $current->id ? 'font-semibold' : ''); ?>">
                            <?php echo e($workspace->name); ?>

                        </button>
                    </form>
                <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
            </div>
        </div>
    <?php endif; ?>
<?php endif; ?>
<?php /**PATH C:\laragon\www\saas\resources\views\components\workspace-switcher.blade.php ENDPATH**/ ?>