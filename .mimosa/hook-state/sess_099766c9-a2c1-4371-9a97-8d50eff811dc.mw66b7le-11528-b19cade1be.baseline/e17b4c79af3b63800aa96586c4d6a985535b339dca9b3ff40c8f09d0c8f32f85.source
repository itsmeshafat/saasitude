            <button type="button" class="btn btn-primary btn-sm" id="tyroLoginExtraSave"
                    <?php if (! (auth()->user()?->hasPrivilege('settings.manage'))): ?> disabled <?php endif; ?>>
                Save Tyro Login settings
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        var saveBtn = document.getElementById('tyroLoginExtraSave');
        if (!saveBtn) return;

        saveBtn.addEventListener('click', function () {
            var panel = document.getElementById('vtab-tyro-login-extra');
            var token = document.querySelector('#systemSettingsForm input[name="_token"]')?.value
                || document.querySelector('meta[name="csrf-token"]')?.content;
            var data = new FormData();

            panel.querySelectorAll('[data-extra-field]').forEach(function (f) {
                f.disabled = false;
                if (f.type === 'checkbox') {
                    if (f.checked) data.append(f.name, f.value);
                } else {
                    data.append(f.name, f.value);
                }
                f.disabled = true; // never submit with the hub's System Settings form
            });

            saveBtn.disabled = true;
            saveBtn.textContent = 'Saving…';

            fetch('<?php echo e(route('admin.tyro-login-extra.update')); ?>', {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': token || '', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                body: data,
            }).then(function (res) { return res.json().then(function (j) { return { ok: res.ok, j: j }; }); })
              .then(function (r) {
                  if (!r.ok) throw new Error(r.j.message || 'Save failed');
                  window.location.reload();
              })
              .catch(function (err) {
                  saveBtn.disabled = false;
                  saveBtn.textContent = 'Save Tyro Login settings (failed — retry)';
              });
        });
    })();
</script>
