<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
    // Theme before first paint: saved preference, else dark (design-system default).
    (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved ? saved === 'dark' : true;
        document.documentElement.classList.toggle('dark', dark);
    })();
</script>
<?php if(auth()->guard()->guest()): ?>
    <title><?php echo $__env->yieldContent('title', config('app.name')); ?> — SaaS billing boilerplate</title>
    <meta name="description" content="<?php echo $__env->yieldContent('meta_description', 'Launch your SaaS with multi-gateway billing, workspaces, entitlements and a mobile API. Powered by Stripe, Paddle and SSLCommerz.'); ?>">
    <meta property="og:title" content="<?php echo $__env->yieldContent('og_title', config('app.name')); ?>">
    <meta property="og:description" content="<?php echo $__env->yieldContent('meta_description', 'Multi-gateway SaaS billing boilerplate.'); ?>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<?php echo e(url()->current()); ?>">
    <meta property="og:image" content="<?php echo e(url('/images/og.png')); ?>">
    <link rel="canonical" href="<?php echo e(url()->current()); ?>">
<?php endif; ?>
<?php if(!file_exists(public_path('build/manifest.json')) && !file_exists(public_path('hot'))): ?>
    
<?php endif; ?>
<?php echo app('Illuminate\Foundation\Vite')('resources/css/app.css'); ?>
</head>
<body>
<div class="wrap">
    <nav class="pub-nav">
        <a class="pub-logo" href="<?php echo e(route('public.home')); ?>"><?php echo e(config('app.name')); ?><span>.</span></a>
        <div class="pub-links">
            <a href="<?php echo e(route('public.pricing')); ?>">Pricing</a>
            <a href="<?php echo e(route('public.changelog')); ?>">Changelog</a>
            <a href="<?php echo e(route('public.contact')); ?>">Contact</a>
            <button type="button" class="theme-btn" id="theme-toggle" aria-label="Toggle theme">◐</button>
        </div>
        <?php if(auth()->guard()->guest()): ?>
            <a class="btn btn-primary" style="padding:9px 18px;font-size:14px" href="<?php echo e(url('/register')); ?>">Sign up free</a>
        <?php else: ?>
            <a class="btn btn-primary" style="padding:9px 18px;font-size:14px" href="<?php echo e(url('/dashboard')); ?>">Dashboard</a>
        <?php endif; ?>
    </nav>

    <?php echo $__env->yieldContent('content'); ?>

    <footer class="pub-footer glass">
        <div>© <?php echo e(now()->year); ?> <?php echo e(config('app.name')); ?>. All rights reserved.</div>
        <div>
            <a href="<?php echo e(route('public.legal', 'terms')); ?>">Terms</a>
            <a href="<?php echo e(route('public.legal', 'privacy')); ?>">Privacy</a>
            <a href="<?php echo e(route('public.legal', 'refund-policy')); ?>">Refunds</a>
        </div>
    </footer>
</div>
<script>
    document.getElementById('theme-toggle').addEventListener('click', function () {
        var dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
</script>
</body>
</html>
